CI_ENVIRONMENT = production
app.baseURL = 'https://inviteandvows.in/'
app.defaultRegion = 'in'

database.default.hostname = localhost
database.default.database = 
database.default.username = 
database.default.password = 
database.default.DBDriver = MySQLi
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

admin.email = 
admin.password = 

# Phase 1
razorpay.keyId = 
razorpay.keySecret = 
razorpay.webhookSecret = 
app.shortDomain = 'wd2.in'

# Order emails (Hostinger SMTP: create a mailbox such as orders@inviteandvows.in)
email.fromEmail = 
email.fromName = Invite & Vows
email.protocol = smtp
email.SMTPHost = smtp.hostinger.com
email.SMTPUser = 
email.SMTPPass = 
email.SMTPPort = 465
email.SMTPCrypto = ssl

# Video invites. browser = the customer's browser records the video (no server needed). server = queue jobs for `php spark video:render`.
video.mode = browser

# Server mode only: render on a machine that has Chromium and ffmpeg, e.g. a VPS. Cron: * * * * * php /path/spark video:render
video.chromiumBin = chromium
video.chromiumFlags = '--no-sandbox'
video.ffmpegBin = ffmpeg
video.size = 1080x1920

# Referrals: percent off for the friend's first purchase and for the referrer's next one (0 switches a side off)
referral.friendPercent = 10
referral.rewardPercent = 10
